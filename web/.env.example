# Chép thành `.env.local` nếu cần đổi. Các giá trị dưới đây chính là mặc định.
# Chỉ biến bắt đầu bằng VITE_ mới vào được code giao diện — đừng đặt bí mật ở đây.

# Đường dẫn gốc của API mà giao diện gọi. Mặc định: cùng origin với giao diện.
VITE_API_BASE_URL=/api

# Chỉ dùng cho `npm run dev`: backend mà Vite chuyển tiếp các request /api tới.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Chu kỳ hỏi lại tiến độ khi có job đang chạy (mili giây). Crawler tải tối đa một trang mỗi
# HTTP_REQUEST_DELAY giây (mặc định 2), nên hỏi dày hơn cũng không thấy gì mới.
VITE_POLL_INTERVAL_MS=2000
