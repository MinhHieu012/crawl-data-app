# Chép file này thành `.env` rồi chỉnh theo nhu cầu. Các giá trị dưới đây chính là mặc định.
# Không commit `.env` (đã có trong .gitignore).

# --- Database ---------------------------------------------------------------
# SQLite: không cần cài gì thêm, file được tạo tự động.
DATABASE_URL=sqlite:///data/crawl-data-app.db
# PostgreSQL: cần `pip install -e ".[postgres]"`.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/novels

# --- HTTP client ------------------------------------------------------------
# Mặc định là "crawl-data-app/<version>". Nên tự nhận là bot và để lại cách liên hệ, ví dụ:
# HTTP_USER_AGENT="crawl-data-app/0.1 (+mailto:ban@example.com)"
# Timeout cho mỗi request (giây)
HTTP_REQUEST_TIMEOUT=20
# Số lần thử lại khi lỗi tạm thời (timeout, lỗi mạng, HTTP 429/5xx); thời gian chờ tăng gấp đôi mỗi lần
HTTP_MAX_RETRIES=3
# Số request đồng thời tối đa (1-8)
HTTP_CONCURRENCY=2
# Khoảng nghỉ giữa hai request liên tiếp, tính bằng giây (tối thiểu 0.5).
# Nếu robots.txt của website yêu cầu Crawl-delay lớn hơn thì crawler dùng giá trị lớn hơn.
HTTP_REQUEST_DELAY=2.0

# --- Crawler ----------------------------------------------------------------
# Định dạng lưu nội dung chương: html (mỗi đoạn một thẻ <p>) hoặc markdown
CRAWLER_CONTENT_FORMAT=html
# Các nguồn tạm ngừng crawl, dạng JSON (trang Nguồn của web UI ghi biến này khi bật/tắt), ví dụ:
# CRAWLER_DISABLED_SOURCES=["truyenfull"]

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Thư mục chứa crawler.log (JSON Lines, tự xoay vòng 5 MB x 3 file)
LOG_DIR=logs
